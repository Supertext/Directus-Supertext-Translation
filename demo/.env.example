# Demo site variables. Set them on the hosting platform (Railway); never commit real values.

# Database: a Postgres server. The demo creates and uses its own database on it
# (DEMO_DATABASE_NAME, default "directus"); on Railway reference the Postgres
# service's DATABASE_URL. Alternatively set DB_CLIENT/DB_CONNECTION_STRING yourself.
DEMO_DATABASE_URL=postgresql://user:password@host:5432/railway
DEMO_DATABASE_NAME=directus
# Long random string (signs tokens)
SECRET=change-me-to-a-long-random-string
# Public address of the demo, e.g. https://directus-production.up.railway.app
PUBLIC_URL=http://localhost:8055

# Supertext AI translation
SUPERTEXT_API_KEY=
# live (default), staging or testing
SUPERTEXT_ENVIRONMENT=live
# Optional explicit API base URL (e.g. a local stand-in), overrides SUPERTEXT_ENVIRONMENT
# SUPERTEXT_API_URL=http://localhost:8765/v1/

# Demo accounts, created on every start if they don't exist yet (existing accounts are
# never changed). Log in at /admin with the e-mail address. Passwords: at least 8 characters
# (and the project's password policy, if one is set).
# With DEMO_ADMIN_* set, Directus's first-run /setup screen no longer appears.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Member of the "Editor" role: articles in every language, may translate with Supertext.
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=
