# Railway service variables for the Directus demo (set them in Railway, never commit real values).

# PostgreSQL server; the demo creates and uses the database DIRECTUS_DB_NAME on it.
DATABASE_URL=${{Postgres.DATABASE_URL}}
# DIRECTUS_DB_NAME=directus

# Random secret used to sign sessions and tokens (e.g. openssl rand -hex 32).
SECRET=

# Demo accounts, created on every start if they don't exist yet (existing accounts are never changed).
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=

# Supertext
SUPERTEXT_API_KEY=
# SUPERTEXT_API_ENDPOINT=https://api.staging.supertext.com/v1/

# Set by Railway
# PORT=8055
# RAILWAY_PUBLIC_DOMAIN=…
